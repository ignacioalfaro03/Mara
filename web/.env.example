# Optional explicit canonical site URL. On Vercel, metadata falls back to the deployment/project URL automatically.
NEXT_PUBLIC_SITE_URL=

# Premium provider handoff remains disabled until explicitly authorized.
NEXT_PUBLIC_PREMIUM_URL=

# Public launch presence. Leave blank to use safe text/monogram fallbacks.
NEXT_PUBLIC_MARA_HERO_IMAGE=
NEXT_PUBLIC_MARA_VOICE_URL=

# Optional account-backed memory. Use a dedicated Mara Supabase project, never Rivalia's project.
# Only the publishable key belongs here. Never expose a secret/service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional same-Mara visual-choice assets. Prefer repository-local paths such as /mara/pose-a.jpg.
# Until these are configured, the canonical Mara portrait is used as a resilient fallback.
NEXT_PUBLIC_MARA_POSE_A_IMAGE=
NEXT_PUBLIC_MARA_POSE_B_IMAGE=
