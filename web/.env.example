# Optional explicit canonical site URL. On Vercel, metadata falls back to the deployment/project URL automatically.
NEXT_PUBLIC_SITE_URL=

# Premium provider handoff remains disabled until explicitly authorized.
NEXT_PUBLIC_PREMIUM_URL=

# Public launch presence. Leave blank to use safe text/monogram fallbacks.
NEXT_PUBLIC_MARA_HERO_IMAGE=
NEXT_PUBLIC_MARA_VOICE_URL=

# Optional account-backed memory. Use a dedicated Mara Supabase project, never another product's project.
# Only the publishable key belongs here. Never expose a secret/service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for commerce checkout intents, creator-owned writes and webhook fulfillment.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Payment runtime. Leave blank until a provider is approved and explicitly activated.
# `signed_test` is a controlled proof provider and must never silently become real-money production.
MARA_PAYMENT_PROVIDER=
MARA_PAYMENT_WEBHOOK_SECRET=

# Server-only launch operator summary token. If unset, /api/internal/launch returns 404.
MARA_OPERATOR_TOKEN=

# Existing controlled creator activation gate.
MARA_ALPHA_CREATOR_ONBOARDING_ENABLED=false

# Product-realization capabilities. Keep OFF in an environment until the matching
# versioned migration/contract has been applied and verified there.
MARA_FOLLOW_SYSTEM_ENABLED=false
MARA_CONTENT_SYSTEM_ENABLED=false
MARA_CRM_SYSTEM_ENABLED=false
MARA_MESSAGING_SYSTEM_ENABLED=false
MARA_REQUESTS_SYSTEM_ENABLED=false
MARA_MEMBERSHIPS_SYSTEM_ENABLED=false

# Future capability placeholders. These flags document the boundary only; setting
# them true must not be treated as implementation by itself.
MARA_EXPERIENCES_SYSTEM_ENABLED=false
MARA_HOST_MARKETPLACE_ENABLED=false
MARA_VOICE_MASKING_ENABLED=false

# Optional same-Mara visual-choice assets. Prefer repository-local paths such as /mara/pose-a.jpg.
# Until these are configured, the canonical Mara portrait is used as a resilient fallback.
NEXT_PUBLIC_MARA_POSE_A_IMAGE=
NEXT_PUBLIC_MARA_POSE_B_IMAGE=
